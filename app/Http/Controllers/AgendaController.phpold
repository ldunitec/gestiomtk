    // Mostrar calendario y tareas sin fecha
    public function index()
    {
        // Eventos ya agendados
        $events = Agenda::whereNotNull('fecha_inicio')
            ->get()
            ->map(function ($event) {
                return [
                    'id' => $event->id,
                    'title' => $event->titulo,
                    'start' => $event->fecha_inicio,
                    'end' => $event->fecha_fin,
                    'color' => $event->color ?? '#3788d8',
                ];
            });

        // Eventos sin fecha
        $unassignedEvents = Agenda::whereNull('fecha_inicio')
            ->where('estado', 1)->get();

        return view('admin.agenda.index', compact('events', 'unassignedEvents'));
    }



    // Crear evento sin fecha
    public function store(Request $request)
    {

        $request->validate(['title' => 'required|string|max:255', 'tipo' => 'string']);
        $tipo = $request->tipo ?? 'Sin categoría';
        $colors = ['Taller' => '#3788d8', 'Visita' => '#28a745', 'Llamada' => '#ffc107', 'Sin categoría' => '#6c757d'];
        $color = $colors[$tipo] ?? '#6c757d';
        $event =
            Agenda::create([
                'titulo' => $request->title,
                'fecha_inicio' => null,
                'fecha_fin' => null,
                // 'color'        => sprintf('#%06X', mt_rand(0, 0xFFFFFF)),
                'color' => $color,
                'usuario_id' => Auth::id(),
            ]);
        // enviar a Todoist
      
        $this->enviarATodoist($event);


        return response()->json([
            'success' => true,
            'event' => [
                'id' => $event->id,
                'title' => $event->titulo,
                'start' => $event->fecha_inicio,
                'end' => $event->fecha_fin,
                'color' => $event->color,
            ]
        ]);


    }


    // Actualizar fecha al mover o arrastrar
    public function updateDate(Request $request, Agenda $event)
    {
        // Solo fecha YYYY-MM-DD
        $start = $request->start;

        $event->update([
            'fecha_inicio' => $start,
        ]);
        $this->enviarATodoist($event);
        // $this->enviarATodoistGrupo($titulo,$event);
        // enviar a Todoist

        return response()->json([
            'success' => true,
            'event' => [
                'id' => $event->id,
                'title' => $event->titulo,
                'start' => $start,
                'color' => $event->color,
            ]
        ]);

    }
    ////////////////////////////////////////////
public function updateNoAgendado(Request $request, Agenda $event)
{
    $event->update($request->only([
        'titulo',
        'fecha_inicio',
        'tipo',
        'estado'
    ]));

    return response()->json(['ok' => true]);
}


    ////////////////////////////////////////////

     public function updateDateItem(Request $request, Agenda $event)
    {
        // Solo fecha YYYY-MM-DD
        $start = $request->start;
        

        $event->update([
            'fecha_inicio' => $start,
        ]);
        // enviar a Todoist
        $this->enviarATodoist($event);

        return response()->json([
            'success' => true,
            'event' => [
                'id' => $event->id,
                'title' => $event->titulo,
                'start' => $start,
                'color' => $event->color,
            ]
        ]);

    }

