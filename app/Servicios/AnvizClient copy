<?php

namespace App\Services;

class AnvizClient
{
    protected $ip;
    protected $port;
    protected $socket;
    protected $deviceId;

    public function __construct($ip, $port = 5010, $deviceId = 1)
    {
        $this->ip = $ip;
        $this->port = $port;
        $this->deviceId = $deviceId;
    }

    public function connect()
    {
        $this->socket = stream_socket_client("tcp://{$this->ip}:{$this->port}", $errno, $errstr, 5);
        if (!$this->socket) {
            throw new \Exception("No se pudo conectar al reloj: $errstr ($errno)");
        }
        stream_set_timeout($this->socket, 3);
    }

    public function disconnect()
    {
        if ($this->socket) {
            fclose($this->socket);
        }
    }

    public function getLogs()
    {
        $this->connect();

        $cmd = $this->buildCmd(0x48); // comando para obtener logs
        fwrite($this->socket, $cmd);

        $response = fread($this->socket, 4096); // puedes ajustar el tamaño

        $this->disconnect();

        return $this->parseLogs($response);
    }

    protected function buildCmd($cmdCode)
    {
        $cmd = pack('C*',
            0xA5, 0xA5,
            $this->deviceId, 0x00,
            $cmdCode, 0x00,
            0x00, 0x00,
            0x00, 0x00
        );

        $crc = $this->crc16($cmd);
        $cmd .= pack('v', $crc);

        return $cmd;
    }

    protected function crc16($data)
    {
        $crc = 0xFFFF;
        for ($i = 0; $i < strlen($data); $i++) {
            $crc ^= ord($data[$i]);
            for ($j = 0; $j < 8; $j++) {
                if ($crc & 0x01) {
                    $crc = ($crc >> 1) ^ 0xA001;
                } else {
                    $crc >>= 1;
                }
            }
        }
        return $crc;
    }

    // ✅ Aquí va parseLogs
    protected function parseLogs($rawData)
    {
        $logs = [];

        $records = str_split(substr($rawData, 12), 40);

        foreach ($records as $record) {
            if (strlen($record) < 40) continue;

            $userId = unpack("v", substr($record, 0, 2))[1];
            $year = 2000 + ord($record[2]);
            $month = ord($record[3]);
            $day = ord($record[4]);
            $hour = ord($record[5]);
            $minute = ord($record[6]);
            $second = ord($record[7]);

            $eventCode = ord($record[8]);
            $evento = match ($eventCode) {
                0x00 => 'Entrada',
                0x01 => 'Salida',
                0x02 => 'Entrada (Admin)',
                0x03 => 'Salida (Admin)',
                default => 'Desconocido',
            };

            $logs[] = [
                'user_id' => $userId,
                'fecha_hora' => "$year-$month-$day $hour:$minute:$second",
                'evento' => $evento,
            ];
        }

        return $logs;
    }
}
